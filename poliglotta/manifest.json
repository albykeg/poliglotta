{
  "manifest_version": 3,
  "name": "Poliglotta – Traduttore per Messenger",
  "short_name": "Poliglotta",
  "version": "1.3.0",
  "description": "Traduce i messaggi di Messenger nella tua lingua e le tue risposte nella lingua di ogni chat, rilevata in automatico. Gratis e senza limiti.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*",
        "https://business.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": [
        "languages.js",
        "format.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Poliglotta",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Attiva o disattiva la traduzione"
    }
  }
}
